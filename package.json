{
  "name": "kaki-dance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A deterministic plush-pocket breaking game for the browser.",
  "scripts": {
    "serve": "python3 -m http.server 4177 --bind 127.0.0.1",
    "audio:build": "node scripts/build-breakbeat.mjs",
    "audio:frolic:build": "node scripts/build-appalachian-audio.mjs",
    "art:frolic:build": "python3 tools/art/build_appalachian_atlases.py",
    "art:frolic:candidate": "python3 tools/art/build_frolic_blender_atlases.py",
    "rig:frolic:build": "blender --background --factory-startup --python tools/blender/build_appalachian_frolic_rig.py",
    "rig:frolic:export": "blender --background --factory-startup --python tools/blender/export_appalachian_simulator_glb.py",
    "check": "node tests/syntax-check.mjs",
    "test": "node --test tests/*.test.js",
    "qa:browser": "node scripts/browser-smoke.mjs",
    "qa:heroes": "node scripts/hero-browser-smoke.mjs",
    "qa:heroes:capture": "node scripts/capture-hero-rescue.mjs",
    "qa:measure:capture": "node scripts/capture-measure-match.mjs",
    "qa:frolic": "node scripts/appalachian-browser-smoke.mjs",
    "qa:frolic:chorus": "node scripts/frolic-full-chorus-smoke.mjs",
    "qa:frolic:capture": "node scripts/capture-appalachian.mjs",
    "qa:frolic:candidate:capture": "node scripts/capture-frolic-rescue-candidate.mjs",
    "qa:frolic:review": "node scripts/frolic-review-smoke.mjs",
    "qa:frolic:latency": "node scripts/frolic-latency-qa.mjs",
    "qa:frolic:motion": "node scripts/frolic-motion-qa.mjs",
    "qa:frolic:foley": "node scripts/frolic-foley-qa.mjs",
    "qa:frolic:manifest": "node scripts/build-frolic-review-manifest.mjs",
    "qa:frolic:candidate": "npm run check && npm test && npm run qa:frolic:motion && npm run qa:frolic:foley && npm run qa:frolic && npm run qa:frolic:latency && npm run qa:frolic:review && npm run qa:frolic:manifest",
    "qa:appalachian-sim:motion": "node scripts/appalachian-simulator-qa.mjs motion",
    "qa:appalachian-sim:arms": "node scripts/appalachian-simulator-qa.mjs arms",
    "qa:appalachian-sim:jumps": "node scripts/appalachian-simulator-qa.mjs jumps",
    "qa:appalachian-sim:audio": "node scripts/appalachian-simulator-qa.mjs audio",
    "qa:appalachian-sim:latency": "node scripts/appalachian-simulator-browser.mjs latency",
    "qa:appalachian-sim:capture": "node scripts/appalachian-simulator-browser.mjs capture",
    "qa:appalachian-sim": "npm run check && npm test && npm run qa:appalachian-sim:motion && npm run qa:appalachian-sim:arms && npm run qa:appalachian-sim:jumps && npm run qa:appalachian-sim:audio && node scripts/appalachian-simulator-browser.mjs smoke && npm run qa:appalachian-sim:latency && npm run qa:frolic:latency",
    "verify": "npm run check && npm test"
  },
  "devDependencies": {
    "playwright": "^1.59.1"
  },
  "dependencies": {
    "three": "^0.185.1"
  }
}
